# =============================================================================
# MissionReady AI — Environment Variables  (single shared file)
# =============================================================================
# Copy this file to src/.env and fill in real values.
# NEVER commit src/.env — it is in .gitignore.
#
# Both the backend (pydantic-settings) and the frontend (next.config.js) read
# this single file.  You do NOT need a separate src/frontend/.env.local.
#
# Backend:  reads every variable via pydantic-settings (case-insensitive).
# Frontend: next.config.js injects only the NEXT_PUBLIC_* variables at build
#           time — all other variables are ignored by Next.js.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────────────────────
# IMPORTANT: Must use the psycopg v3 driver prefix: postgresql+psycopg://
# Docker Compose default:
DATABASE_URL=postgresql+psycopg://missionready:missionready_dev_password@localhost:5432/missionready
# Cloud DB example (Neon/Supabase — replace with your actual URL):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Vite dev server runs on 5173; Next.js on 3000.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=

# ─── IBM watsonx.ai (required for Phase 11 AI Copilot) ───────────────────────
# Obtain from IBM Cloud console.
WATSONX_API_KEY=your_ibm_watsonx_api_key_here
WATSONX_PROJECT_ID=your_ibm_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ─── Groq (fallback LLM — used if watsonx.ai is not configured) ──────────────
# Obtain from https://console.groq.com/keys
# Leave blank to disable Groq fallback.
GROQ_API_KEY=
# Override the default model (optional):
# GROQ_MODEL=compound-beta

# ─── Notifications (optional) ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# These are read by next.config.js and baked into the browser bundle at build
# time.  For Docker builds the values can be overridden via --build-arg.
#
# URL the browser uses to reach the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
#
# Google OAuth client ID — must match GOOGLE_CLIENT_ID above.
# Leave blank to show the Google button in a disabled state.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
